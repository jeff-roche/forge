{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge",
  "identifier": "dev.forge-ide.forge",
  "build": {
    "frontendDist": "../../web/packages/app/dist",
    "beforeBuildCommand": "pnpm -C ../web --filter app build",
    "beforeDevCommand": "pnpm -C ../web --filter app dev",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src-elem 'self'; style-src-attr 'self'; img-src 'self' data: asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Development",
    "shortDescription": "Forge — a desktop workshop for agentic work.",
    "longDescription": "Forge is a native desktop workshop for agentic work. Any AI, one editor, transparent by default.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "forge.desktop",
        "files": {
          "/usr/share/pixmaps/forge.png": "icons/512x512.png",
          "/usr/share/icons/hicolor/32x32/apps/forge.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/forge.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/forge.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/512x512/apps/forge.png": "icons/512x512.png"
        }
      },
      "rpm": {
        "desktopTemplate": "forge.desktop",
        "files": {
          "/usr/share/pixmaps/forge.png": "icons/512x512.png",
          "/usr/share/icons/hicolor/32x32/apps/forge.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/forge.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/forge.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/512x512/apps/forge.png": "icons/512x512.png"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
